# Required for all environments
EMDASH_ENCRYPTION_KEY=

# Production site URL (set after first Vercel deploy)
SITE_URL=https://your-project.vercel.app

# Turso / libSQL database (production on Vercel)
LIBSQL_DATABASE_URL=libsql://your-db-name.turso.io
LIBSQL_AUTH_TOKEN=

# Upstash Redis for admin sessions (production on Vercel)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# S3-compatible media storage (production on Vercel)
# Works with Cloudflare R2, AWS S3, or Vercel Blob via S3 API
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PUBLIC_URL=

# GitHub OAuth for admin login on production (recommended on Vercel)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
